# Bắt buộc: >= 32 ký tự
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
TOKEN_TTL_SECONDS=3600
AUTH_COOKIE_NAME=lms_token

# PostgreSQL (khuyến nghị)
DATABASE_URL=postgresql+psycopg://lms_dev:lms_dev_2026@127.0.0.1:5432/lms_dev
# Hoặc SQLite để chạy thử nhanh:
# DATABASE_URL=sqlite:///instance/lms.db

# Thư mục lưu tệp và email dev
UPLOAD_DIR=instance/uploads
MAIL_DIR=instance/mail
MAIL_FROM=no-reply@minilms.local

# SMTP thật (tuỳ chọn). Bỏ trống = ghi email ra instance/mail/*.eml
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# URL goc dung de dung link trong email (chong Host header injection)
PUBLIC_BASE_URL=http://127.0.0.1:8888
# Bat khi chay HTTPS
# SESSION_COOKIE_SECURE=true
# Chi bat khi dev (Werkzeug debugger = RCE neu lo ra ngoai)
# FLASK_DEBUG=1
